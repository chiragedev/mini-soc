<!--
  Mini SOC — Custom Detection Rules
  MITRE ATT&CK Mapped Rules for Wazuh
  
  These rules detect common attack patterns and map them
  to MITRE ATT&CK techniques for SOC correlation.
-->

<group name="mini_soc,">

  <!-- ====================================================
       T1110.001 — Brute Force: Password Guessing
       Detects 8+ failed Windows logon attempts in 120 seconds
       ==================================================== -->
  <rule id="100001" level="10" frequency="8" timeframe="120">
    <if_matched_sid>60122</if_matched_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Mini SOC: Possible brute force attack — $(win.eventdata.targetUserName) — 8+ failed logon attempts in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,brute_force,</group>
  </rule>

  <!-- Brute force followed by successful logon = compromised -->
  <rule id="100002" level="14" timeframe="300">
    <if_matched_sid>100001</if_matched_sid>
    <if_sid>60103</if_sid>
    <same_field>win.eventdata.targetUserName</same_field>
    <description>Mini SOC: CRITICAL — Successful logon after brute force for user $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_failures,brute_force,compromised,</group>
  </rule>

  <!-- ====================================================
       T1059.001 — Command and Scripting Interpreter: PowerShell
       Detects suspicious PowerShell execution patterns
       ==================================================== -->
  <rule id="100003" level="12">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-enc\s|-encodedcommand\s|-e\s+[A-Za-z0-9+/=]{20,})</field>
    <description>Mini SOC: Encoded PowerShell command detected — possible obfuscated attack</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>powershell,execution,defense_evasion,</group>
  </rule>

  <rule id="100004" level="12">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Invoke-Expression|IEX|Invoke-WebRequest|Net\.WebClient|DownloadString|DownloadFile|Start-BitsTransfer)</field>
    <description>Mini SOC: Suspicious PowerShell download cradle detected — $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
    <group>powershell,execution,ingress_tool_transfer,</group>
  </rule>

  <!-- ====================================================
       T1003.001 — OS Credential Dumping: LSASS Memory
       Detects Mimikatz-related keywords and LSASS access
       ==================================================== -->
  <rule id="100005" level="14">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(mimikatz|sekurlsa|logonpasswords|lsadump|kerberos::list|crypto::certificates|privilege::debug)</field>
    <description>Mini SOC: CRITICAL — Mimikatz-related keywords detected in process command line</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,mimikatz,critical,</group>
  </rule>

  <!-- LSASS access detection via Sysmon Event ID 10 -->
  <rule id="100006" level="14">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x1010|0x1FFFFF</field>
    <description>Mini SOC: CRITICAL — Suspicious access to LSASS process detected — possible credential dumping</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>credential_access,lsass,critical,</group>
  </rule>

  <!-- ====================================================
       T1547.001 — Boot/Logon Autostart: Registry Run Keys
       Detects modifications to common persistence locations
       ==================================================== -->
  <rule id="100007" level="10">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)(CurrentVersion\\Run|CurrentVersion\\RunOnce|Winlogon\\Shell|Winlogon\\Userinit)</field>
    <description>Mini SOC: Registry persistence detected — modification to autostart key</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>persistence,registry,</group>
  </rule>

  <!-- ====================================================
       T1070.001 — Indicator Removal: Clear Windows Event Logs
       Detects when event logs are cleared (defense evasion)
       ==================================================== -->
  <rule id="100008" level="12">
    <if_sid>60140</if_sid>
    <description>Mini SOC: Windows Event Log cleared — possible evidence tampering</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,log_clearing,</group>
  </rule>

  <!-- Also detect via PowerShell Clear-EventLog -->
  <rule id="100009" level="12">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(Clear-EventLog|wevtutil\s+(cl|clear-log))</field>
    <description>Mini SOC: Event log clearing command detected — defense evasion</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>defense_evasion,log_clearing,</group>
  </rule>

  <!-- ====================================================
       T1569.002 — System Services: Service Execution
       Detects new service installations
       ==================================================== -->
  <rule id="100010" level="8">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(sc\s+create|New-Service|sc\.exe.*create)</field>
    <description>Mini SOC: New Windows service created — $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1569.002</id>
      <id>T1543.003</id>
    </mitre>
    <group>persistence,service_creation,</group>
  </rule>

  <!-- ====================================================
       T1053.005 — Scheduled Task
       Detects creation of scheduled tasks for persistence
       ==================================================== -->
  <rule id="100011" level="10">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(schtasks\s+/create|Register-ScheduledTask)</field>
    <description>Mini SOC: Scheduled task created — possible persistence mechanism</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>persistence,scheduled_task,</group>
  </rule>

  <!-- ====================================================
       T1136.001 — Create Account: Local Account
       Detects creation of new local user accounts
       ==================================================== -->
  <rule id="100012" level="10">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net\s+user\s+\S+\s+/add|New-LocalUser)</field>
    <description>Mini SOC: New local user account created — $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1136.001</id>
    </mitre>
    <group>persistence,account_creation,</group>
  </rule>

  <!-- ====================================================
       T1087.001 — Account Discovery: Local Account
       Detects enumeration of local accounts
       ==================================================== -->
  <rule id="100013" level="6">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(net\s+user$|net\s+localgroup|Get-LocalUser|Get-LocalGroupMember|whoami\s+/all)</field>
    <description>Mini SOC: Local account enumeration detected — reconnaissance activity</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>discovery,account_enumeration,</group>
  </rule>

  <!-- ====================================================
       T1082 — System Information Discovery
       Detects system reconnaissance commands
       ==================================================== -->
  <rule id="100014" level="6">
    <if_sid>92200</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(systeminfo|hostname|ipconfig\s+/all|Get-ComputerInfo|wmic\s+os\s+get)</field>
    <description>Mini SOC: System information discovery — reconnaissance activity</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery,system_info,</group>
  </rule>

</group>
